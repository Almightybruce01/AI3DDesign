# Copy to .env and fill in. Keys never leave the server.
# If a key was ever pasted in chat/email, rotate it in the provider dashboard.

# LLM — pick one or combine (Groq = free fast text; OpenAI = vision + DALL·E + fine-tunes)
#
# Free tier (recommended to start): Groq — https://console.groq.com/keys — OpenAI-compatible API
#   GROQ_API_KEY=gsk_...
# (Optional) If unset, we default chat base URL to Groq when only GROQ_API_KEY is set.
#
# OpenAI — GPT-4o vision (chain photo, image briefs), DALL·E, fine-tuning
OPENAI_API_KEY=
#
# Other OpenAI-compatible hosts (optional):
#   OPENAI_BASE_URL=https://api.openai.com/v1   (default when OPENAI_API_KEY is set)
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1   (Ollama) + OPENAI_ALLOW_NO_KEY=1
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1 + OPENAI_API_KEY=sk-or-v1-...
# DALL·E 3 still needs OPENAI_API_KEY unless you only use Replicate/local fallback.
# OPENAI_ALLOW_NO_KEY=1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional override (default gpt-4o-mini). If set, also used when LLM_MODEL unset for prompt expansion.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Fine-tuned chat model (OpenAI ft:...) — copilot, Complex text, image prompt expansion; set after training.
# LLM_MODEL=
#
# When BOTH GROQ_API_KEY and OPENAI_API_KEY exist: text chat tries Groq first (your fast path), then OpenAI on failure.
# LLM_PRIMARY=groq
# LLM_PRIMARY=openai
# Optional Groq model id when routing to Groq (if LLM_MODEL is ft:…, Groq uses this instead).
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Chain photo: if GPT-4o vision fails but Groq is set, fall back to text-only analysis (set 0 to disable).
# LLM_VISION_FALLBACK_NOTES=1
#
# Fine-tuning (matrix-ai-hub: npm run finetune)
# FINETUNE_TRY_MODELS=gpt-4o-mini-2024-07-18,gpt-4o-2024-08-06
# FINETUNE_POLL_SEC=20
# FINETUNE_MAX_WAIT_MIN=120
# Set to 0 to only queue the job and exit (poll in dashboard).
# Complex + chain photo vision (pinned GPT-4o; not the same as LLM_MODEL ft: text fine-tune)
OPENAI_VISION_MODEL=gpt-4o-2024-08-06
# Optional: force Complex text JSON to a specific model (otherwise uses LLM_MODEL or gpt-4o)
# COMPLEX_TEXT_MODEL=

# Replicate: Flux Schnell + instruct-pix2pix (photo→photo edits)
REPLICATE_API_TOKEN=
# REPLICATE_PIX2PIX_MODEL=timothybrooks/instruct-pix2pix
# REPLICATE_PIX2PIX_STEPS=20
# REPLICATE_PIX2PIX_GUIDANCE=1.2

# Blender: “Open in Blender” launches GUI and imports the last/generated STL
# macOS default below; on Windows set full path to blender.exe
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# Server
# PORT=3000

# --- Matrix AI Hub (Vercel) + workshop bridge (optional — same keys in Vercel project settings)
# Hub reads these when deployed; sync with: cd matrix-ai-hub && npm run sync-env
# OPENAI_CHAT_MODEL=gpt-4o-mini
# LLM_SYSTEM_APPEND=
# REPLICATE_API_TOKEN=
# Public Node workshop (no trailing slash) — not localhost in production
# WORKSHOP_API_BASE_URL=https://your-workshop.example.com
# NEXT_PUBLIC_WORKSHOP_API=https://your-workshop.example.com
