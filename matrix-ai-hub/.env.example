# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.

# --- LLM (no Cursor required — pick Groq free or OpenAI)
# Free + fast: https://console.groq.com/keys  → paste below (we default API URL to Groq)
GROQ_API_KEY=
# OpenAI — use for vision/DALL·E/fine-tunes, or as primary if you prefer
OPENAI_API_KEY=
# If unset: OPENAI key → api.openai.com; only GROQ_KEY → api.groq.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model: hub defaults to llama-3.3-70b-versatile with Groq-only, else gpt-4o unless you set:
LLM_MODEL=
# Optional extra system text (Vercel) — appended to the bundled elite Matrix prompt
# LLM_SYSTEM_APPEND=


# --- Matrix Workshop (separate Node server — potrace / jewelry CSG / STL)
# Server-side proxy (recommended for vector route). No trailing slash.
WORKSHOP_API_BASE_URL=https://your-workshop.example.com
# Browser links to generated SVG (same host, public)
NEXT_PUBLIC_WORKSHOP_API=https://your-workshop.example.com
